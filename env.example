# Browser-safe build variables
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Netlify environment variables
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://animated-raindrop-2d6d48.netlify.app/.netlify/functions/google-auth-callback
SITE_URL=https://animated-raindrop-2d6d48.netlify.app

# No extra STATE_SECRET or TOKEN_ENCRYPTION_KEY is required in v0.3.1.
# The server derives independent cryptographic keys from SUPABASE_SERVICE_ROLE_KEY.
